# Обязательно: ключ сессии аккаунта FunPay.
FUNPAY_GOLDEN_KEY=<YOUR_FUNPAY_GOLDEN_KEY>

# Обязательно: токен Telegram-бота от BotFather.
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Обязательно: числовой Telegram ID владельца.
ADMIN_ID=<YOUR_TELEGRAM_NUMERIC_ID>

# Обязательно: числовой FunPay ID; при запуске сверяется с сессией.
FUNPAY_USER_ID=<YOUR_FUNPAY_NUMERIC_ID>

# Необязательно: оставьте пустым, чтобы отключить пароль для других пользователей Telegram.
BOT_PASSWORD=

# Необязательно: 1 включает дополнительные диагностические сообщения; по умолчанию 0.
DEBUG=0
