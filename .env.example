# Required: FunPay account session credential.
FUNPAY_GOLDEN_KEY=<YOUR_FUNPAY_GOLDEN_KEY>

# Required: Telegram bot token from BotFather.
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Required: numeric Telegram ID of the owner.
ADMIN_ID=<YOUR_TELEGRAM_NUMERIC_ID>

# Required: numeric FunPay account ID; startup verifies it against the session.
FUNPAY_USER_ID=<YOUR_FUNPAY_NUMERIC_ID>

# Optional: leave empty to disable password access for additional Telegram users.
BOT_PASSWORD=

# Optional: 1 enables extra application diagnostics; default is 0.
DEBUG=0
